# Texto versionado com finais de linha determinísticos.
* text=auto

*.py text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
/.env.example text eol=lf
/.gitignore text eol=lf
/.gitattributes text eol=lf

# Formatos binários não devem sofrer conversão.
*.xlsx binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.mp4 binary
*.mov binary
*.webm binary
*.zip binary
