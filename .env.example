# Copie este arquivo para .env e preencha somente valores locais.
# Nunca versione o .env real.

# Variáveis reconhecidas pelo gflow e mantidas para compatibilidade.
# Deixe GFLOW_CLI_HOME vazio para usar o perfil padrão do gflow-cli.
GFLOW_CLI_HOME=
GFLOW_CLI_HEADLESS=false
GFLOW_CLI_FLOW_HOST=flow.google.com
GFLOW_CLI_DEFAULT_PROJECT=
GFLOW_CLI_OUTPUT_DIR=
GFLOW_CLI_LOG_FORMAT=

# Configuração centralizada do pipeline
# Argumentos explícitos da CLI sobrescrevem estes valores.
# Variáveis do processo sobrescrevem valores equivalentes deste arquivo.
GFLOW_PROJECT_ID=
# Deixe vazio para usar .venv/Scripts/gflow.exe deste projeto.
# Preencha somente para manter uma instalação externa existente.
GFLOW_ROOT=
PIPELINE_SPREADSHEET=entradas/controle_pipeline_flow.xlsx
PIPELINE_OUTPUT_DIR=preparados
PIPELINE_DELIVERY_DIR=entregas_flow
GFLOW_VIDEO_MODEL=omni-flash
GFLOW_TIMEOUT_SECONDS=1800
WEB_HOST=127.0.0.1
WEB_PORT=8765
